# Виртуальное окружение, которое создаёт run.bat  
.venv/  
venv/  
  
# Кэш Python  
__pycache__/  
*.py[cod]  
  
# Результаты выгрузки и временные файлы  
*.xlsx  
~$*.xlsx  
*.download  
*.log  
  
# Сборка exe (PyInstaller)  
build/  
dist/  
*.spec

# Файл с рабочим адресом RSS-канала ЭТП ГПБ — локальная настройка,
# в репозиторий не попадает (см. README, раздел «Частые проблемы»)
etpgpb_feed.txt
